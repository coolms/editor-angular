{
  "name": "@coolms/editor-angular",
  "version": "0.1.0",
  "private": true,
  "description": "The CoolMS rich-text editor for Angular: a Tiptap bridge with a pluggable action and extension registry, paged layout, and DTMPL-aware widget transforms.",
  "license": "MIT",
  "author": {
    "name": "Dmitry Popov",
    "email": "d.popov@coolms.com"
  },
  "type": "module",
  "peerDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@coolms/core-angular": "^0.2.0",
    "@coolms/document-engine": "^0.1.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@coolms/document-engine": {
      "optional": true
    }
  },
  "dependencies": {
    "@tiptap/core": "^3.20.4",
    "@tiptap/extension-blockquote": "^3.20.4",
    "@tiptap/extension-bold": "^3.20.4",
    "@tiptap/extension-bullet-list": "^3.20.4",
    "@tiptap/extension-code": "^3.20.4",
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-document": "^3.20.4",
    "@tiptap/extension-gapcursor": "^3.20.4",
    "@tiptap/extension-hard-break": "^3.20.4",
    "@tiptap/extension-heading": "^3.20.4",
    "@tiptap/extension-history": "^3.20.4",
    "@tiptap/extension-italic": "^3.20.4",
    "@tiptap/extension-link": "^3.20.4",
    "@tiptap/extension-list-item": "^3.20.4",
    "@tiptap/extension-ordered-list": "^3.20.4",
    "@tiptap/extension-paragraph": "^3.20.4",
    "@tiptap/extension-strike": "^3.20.4",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-cell": "^3.22.5",
    "@tiptap/extension-table-header": "^3.22.5",
    "@tiptap/extension-table-row": "^3.22.5",
    "@tiptap/extension-text": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "lowlight": "^3.3.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "keywords": [
    "coolms",
    "angular",
    "editor",
    "tiptap",
    "rich-text",
    "wysiwyg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coolms/editor-angular.git"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.28.0",
    "globals": "^15.15.0",
    "ng-packagr": "^22.1.1",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.33.1"
  }
}
